# .hooksrc — Git Hook 门禁配置（脚手架模板）
# 复制本文件为 .hooksrc 后按需调整；键格式 key=value，行首 # 注释。
# 等级四级：required(不吃SKIP) | error(拦截) | warn(仅警告) | off(跳过)
# 引擎文档：docs/GIT_HOOKS.md

# ── 旧键（后兼容别名，等价于 gate.<id>.level）──
requireCommitMsg=true     # 是否强制提交格式（恒为 true 才有 Conventional 校验）
emojiLevel=error          # → gate.emoji.level
mojibakeLevel=error       # → gate.mojibake.level
secretLevel=error         # → gate.secrets.level
lintLevel=error           # → gate.impact-test.level（影响面测试）
trailerLevel=error        # → gate.commit-msg.level（AI 尾巴等）

# ── 原生门等级（新写法，与旧键等价）──
# gate.secrets.level=error
# gate.large-file.level=error
# gate.commit-msg.level=error
# gate.pre-push-verify.level=error
# gate.impact-test.level=error
# gate.whitespace.level=warn       # 行尾空白/EOF 换行（run fix 自愈；--dry-run 预览；exclude 已带 vertical/**）
# gate.eol.level=error             # EOL 契约对账：eol=lf 域 staged CRLF=error；钉制域钉缺席=error；
                                  # 无钉制裸 CRLF=warn（run fix 归一化工作区字节）
# gate.eol.pinGlobs=.githooks/**,*.sh   # 强制 LF 钉制域（shebang 字节敏感面；CSV glob）

# ── 项目私有门 ──
# scripts/hooks/gates.local/*.mjs  # 入仓的项目特有门（与 gates/ 同接口，如 go-verify）
# gate.boundary-edge.level=error   # ming-boundary 边界契约门（-WithBoundary 采纳面；
#                                  # 仓根无 boundaries.yaml 自动静默跳过）
# 仓特有门缺依赖自动缺席：impact-test 需 tests/run.mjs；pre-push-verify 需 scripts/verify.mjs

# ── secrets 门多层调优 ──
# gate.secrets.genericLevel=warn   # L2 通用赋值层（key/token=值+熵检+占位符白名单）：warn|error|off
# gate.secrets.b64Level=warn       # L3 base64 夹带解码（仅可疑文件名）：warn|error|off

# ── pii 个人数据卫生门 ──
# gate.pii.level=error             # 家目录路径/CN个人邮箱域=error；/home/与手机号=warn；fixture 名白名单内置
# gate.pii.exclude=a/**            # 追加排除 glob（vendored/文档示例目录走此键）

# ── author-identity 提交身份门（与 pii 同源防线：pii 扫内容，本门堵 author/committer 元数据）──
# gate.author-identity.level=error # 哨兵占位(t@t/*@example.*/*@localhost/空邮箱)+CN个人邮箱域命中即拦
# gate.author-identity.allow=*@users.noreply.github.com  # CSV 白名单 glob：配后 email 必须命中（单作者公开仓推荐）
# gate.author-identity.deny=me@corp.example              # CSV 追加哨兵 glob
# gate.author-identity.check=both  # both|author|committer（amend/cherry-pick 用 committer 侧，默认双查）
# gate.secrets.exclude=a/**,b/**   # 追加排除 glob（默认空——仓专目录走此键）

# ── commit-msg 策略词表（采纳项目改配置不改代码；kit 默认=Conventional 11 型+空禁尾表）──
# gate.commit-msg.types=feat,fix,docs            # type 白名单覆盖（自动合成主题正则）
# gate.commit-msg.pattern=^TASK-\d+: .+          # 主题正则整体覆盖（配 patternHint 提示文案）
# gate.commit-msg.subjectMaxLen=72               # 主题长度上限（warn 级，0=不限）
# gate.commit-msg.bannedTrailers=^Generated with\b,^Co-Authored-By\s*:   # 禁尾表整体替换（CSV 正则，不可含逗号）
# gate.commit-msg.extraTrailers=^Signed-off-by   # 追加禁尾正则（CSV）
# gate.commit-msg.subjectCjk=true                # subject 须含中日韩字符（仓私有规范，默认关）
# gate.commit-msg.bodySections=实施内容,本提交不授权,已执行审阅  # 正文必含标记集（CSV；sectionTypes 限定 type 集，缺省 feat,fix,refactor,docs）

# ── 声明式正则门（单模式+单消息长尾，零代码）──
# gate.<id>.level=<等级>
# gate.<id>.pattern=<正则>            # 必填；逐行扫描 staged blob
# gate.<id>.message=<报告文案>
# gate.<id>.globs=a,b                 # 可选；无斜杠=basename 匹配，有斜杠=路径前缀；缺省=全部文件
# gate.<id>.exclude=a,b               # 可选；排除 globs
# gate.<id>.once=true                 # 可选；每文件只报一次（刷屏防护）
# gate.<id>.skipIf=merge,rebase       # 可选；git 态条件（merge/rebase/cherry-pick/ref:<branch>）
#
# 示例：
# gate.no-debugger.level=error
# gate.no-debugger.globs=*.js,*.ts,*.mjs
# gate.no-debugger.pattern=\bdebugger\b
# gate.no-debugger.message=调试语句残留
#
# gate.fixme.level=warn
# gate.fixme.pattern=FIXME|XXX|HACK
# gate.fixme.message=遗留标记待清理
# gate.fixme.once=true

# ── chores 族（suggest-only 非阻断自动化，post-merge 等阶段提醒，永不执行命令）──
# chore.<id>.watch=<globs CSV>   监看文件（变更即提醒）
# chore.<id>.message=<文案>      提醒内容（自动附触发文件清单）
# chore.<id>.stages=<CSV>        挂载阶段（默认 post-merge；post-checkout=分支切换时 diff 增量）
# 示例：
# chore.deps.watch=package-lock.json,package.json
# chore.deps.message=依赖清单变更——建议 npm ci

# ── toc 门（## 目录 生成节对账，fixable——run fix 重写/插壳）──
# gate.toc.level=warn              # 等级
# gate.toc.globs=*.md              # 域硬边界（默认全部 md；vertical/base 默认排除）
# gate.toc.depth=3                 # 收录最大标题级（编号=收集序，>depth 占位跳号）
# gate.toc.titles=目录,Table of Contents   # 目录节标题精确集
# gate.toc.mode=section            # section=只刷已有壳 | insert=达标文档补插壳
# gate.toc.minHeadings=3           # insert 模式门槛
# gate.toc.slug=github             # github=GitHub 锚算法 | compat=tocgen 旧算法

# ── [glob] 分节覆盖（域内调参，editorconfig 语义）──
# 全局段之后 [glob] 节头开启路径覆盖域；glob 相对仓根；后写节覆盖先写节；
# .hooksrc.local 的节接在主文件节之后（天然 local 赢）。
# 节内仅 gate.*/chore.* 键（其余键与空节走 integrityLevel 告警）；
# 节只能调参不能扩域——globs 域外文件先改全局 globs。
# 示例：
# [docs/adr/**.md]
# gate.toc.depth=2
#
# [docs/progress/**]
# gate.toc.level=off

# ── 周期维度（review-after 到期提醒 + cadence 节流）──
# gate.review-after.globs=<globs>   # 扫描域（默认空——不配不跑）；提取 reviewAfter: YYYY-MM-DD 到期 warn
# gate.review-after.cadence=7d      # TTL 节流：<n>d|h|m|s；state.json lastRun 盖戳，到期才跑
# cadence 是引擎级通用键——任何门/chore 可配
#
# ── 死链检查（link-rot：post-merge/post-checkout 非阻断，网络 IO 靠 cadence 节流）──
# gate.link-rot.globs=docs/**,*.md   # 扫描域（默认空——不配不跑）
# gate.link-rot.cadence=7d           # 建议周期节流；每次全量探测贵
# gate.link-rot.ignore=localhost,example.com   # 子串过滤（占位符/内网域）
# gate.link-rot.maxUrls=50           # 单次上限，超出截断提示
# gate.link-rot.timeoutMs=5000       # 单 URL 超时

# ── 引擎级通用门键（任意 gate id 可配，非单门专属）──
# gate.<id>.level=off|warn|error      # 等级覆写
# gate.<id>.globs=<globs CSV>         # 整体替换兴趣域
# gate.<id>.exclude=<globs CSV>       # 在门默认排除上追加
# gate.<id>.cadence=<n>d|h|m|s        # 周期节流（state.json 盖戳）

# ── 声明式杂务（chore.<id>.* —— suggest-only 提醒门，永不执行命令/永不阻断）──
# chore.<id>.watch=<globs CSV>   # 监看文件域（命中变更即提醒；缺 watch/message 静默略过）
# chore.<id>.message=<文案>       # 提醒内容
# chore.<id>.stages=<CSV>        # 挂载阶段（默认 post-merge）
# chore.hooks.watch=scripts/hooks/**,.githooks/**
# chore.hooks.message=门禁引擎文件变更——确认后执行 node scripts/hooks/engine.mjs trust

# ── 命令门（impact-test 提交前 / pre-push-verify 推送前）──
# gate.<id>.command=<完整命令行>   # 仓级命令覆盖默认（CI yaml run: 同级执行面——review diff 关注）
# gate.impact-test.command=node tests/run.mjs --require-all       # 默认即此；未配且无 tests/run.mjs 自动缺席
# gate.pre-push-verify.command=node scripts/verify.mjs --profile full
# gate.impact-test.timeoutMs=600000      # 命令预算；超时绞整棵进程树并拦截（防门命令挂死=永卡）
# gate.pre-push-verify.timeoutMs=900000

# ── 引擎级配置 ──
# integrityLevel=warn    # gates/ 目录 hash 变化提示等级（warn|off）
# baseline.path=<路径>   # 基线文件位置覆盖（默认 .hooks-baseline.json）
# SKIP=<gate1>,<gate2>   # 环境变量：临时豁免点名门；required 级不受影响

# ── 引擎子命令 ──
# node scripts/hooks/engine.mjs list        # 列出门清单与生效等级
# node scripts/hooks/engine.mjs run check   # 命名组：按暂存/改动文件跑门禁（等价 pre-commit 检查）
# node scripts/hooks/engine.mjs run ci      # 命名组：全树扫描（git ls-files + 工作区读）
# node scripts/hooks/engine.mjs baseline    # 冻结当前全部违规到 .hooks-baseline.json
# node scripts/hooks/engine.mjs trust       # 确认 gates/ 目录当前 hash（完整性再确认）
