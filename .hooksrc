# .hooksrc — ming-skills Git Hook 分级配置文件
# 等级语义: error (阻断提交) | warn (打印警告不阻断) | off (跳过该检查)

# 1. 提交格式（本仓词表=Conventional 11 型 + 仓专 collect/sync/merge；
#    署名禁令=本仓清史后政策——kit 默认空表，此处整体替换注入；CSV 正则不可含逗号）
requireCommitMsg=true
gate.commit-msg.types=feat,fix,chore,docs,style,refactor,test,perf,revert,collect,sync,merge
gate.commit-msg.bannedTrailers=^Generated with\b,^Co-Authored-By\s*:

# 2. Emoji 绝对禁令（严禁在技能、文档与提交中使用 emoji，使用 [禁止]/[警告]/[性能] 等文本标签）
#    自研文档/技能面作用域（精确文件名 README.md 只认根——deep README 由 docs/**/private/** 覆盖）
emojiLevel=error
gate.emoji.globs=private/**,docs/**,README.md

# 3. 编码防污染检查（严禁在 registry/文档/技能中写入 GBK/ANSI 转义乱码）
#    vertical/** vendored 上游文档编码归上游负责
mojibakeLevel=error
gate.mojibake.exclude=vertical/**

# 4. 敏感密钥拦截（三层规则：L1 签名层 19 模式 / L2 通用赋值+熵检 warn / L3 UTF-16+b64 编码配对 warn）
#    vertical/** 为 vendored 上游内容——其 fixture 假密钥非本仓安全面（供应链层管 provenance，不管内容）
secretLevel=error
gate.secrets.exclude=vertical/**
gate.secrets.genericLevel=warn
gate.secrets.b64Level=warn

# 4b. 个人数据卫生（与 secrets 互补：secrets 管密钥，pii 管个人标识）
#     家目录路径(C:\Users\xxx /Users/xxx)=error、CN 个人邮箱域=error、
#     /home/xxx 与手机号=warn（CTF/示例合法密度高，fixture 名白名单在内）
gate.pii.level=error
gate.pii.exclude=vertical/**

# 5. 自动化测试门禁（提交前命令门——command 键指向 verify affected：
#    由 scripts/plan.mjs 做影响面计划，docs-only 提交免测放行）
lintLevel=error
gate.impact-test.command=node scripts/verify.mjs --profile affected
gate.impact-test.timeoutMs=600000

# 6. AI 署名 trailer 门禁（拦截 Generated with / Co-Authored-By 字段；署名即作者本人）
trailerLevel=error

# 7. 可自愈门仓专排除（门默认值仓中性——本仓 vendored/上游目录走配置排除）
gate.whitespace.exclude=vertical/**
gate.toc.exclude=vertical/**,base/**

# 8. 候审档到期提醒（周期维度：reviewAfter 日期到期 warn；cadence 节流 7 天）
gate.review-after.globs=distill/_proposals/*.md
gate.review-after.cadence=7d

# 9. 死链检查（周期维度：post-merge/post-checkout 非阻断；cadence 节流 7 天）
gate.link-rot.globs=docs/**,private/**/*.md,README.md,AGENTS.md
gate.link-rot.cadence=7d
gate.link-rot.ignore=localhost,127.0.0.1,example.com
gate.link-rot.maxUrls=50

# 10. vertical 物化区边界（远端仅存索引——staged ∩ vertical/ ⊆ registry sourceGone 白名单）
gate.vendor-boundary.level=error

# 11. 部署漂移对账（仓专：registry deploy 声明 ⟺ .cc-switch 实际链接；warn 提醒级 + 7d 节流）
gate.deploy-drift.level=warn
gate.deploy-drift.cadence=7d

# 12. 结构边界增量门（ming-boundary：staged 新边 x boundaries.yaml 契约
#     forbidden/allowed/dead 即拦；regex-degraded 证据自动降 warn 人工复核）
gate.boundary-edge.level=error

# ── chores 族（suggest-only：只提醒不执行，默认 post-merge；chore.<id>.stages 可挂 post-checkout）──
chore.registry.watch=registry.yaml
chore.registry.message=registry.yaml 已变更——建议 pwsh scripts/sync.ps1 -DryRun 预览部署差异
chore.submodule.watch=base/reverse-skill
chore.submodule.stages=post-merge,post-checkout
chore.submodule.message=submodule 指针已更新——执行 git submodule update --init 同步基座
chore.hooks.watch=scripts/hooks/**,.githooks/**
chore.hooks.message=门禁引擎/shim 已变更——确认无误后执行 node scripts/hooks/engine.mjs trust 再确认完整性
