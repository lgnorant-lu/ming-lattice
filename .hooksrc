# .hooksrc — ming-skills Git Hook 分级配置文件
# 等级语义: error (阻断提交) | warn (打印警告不阻断) | off (跳过该检查)

# 1. 提交格式 (feat/fix/chore/docs/style/refactor/test/perf/revert/collect/sync)
requireCommitMsg=true

# 2. Emoji 绝对禁令（严禁在技能、文档与提交中使用 emoji，使用 [禁止]/[警告]/[性能] 等文本标签）
#    自研文档/技能面作用域（精确文件名 README.md 只认根——deep README 由 docs/**/private/** 覆盖）
emojiLevel=error
gate.emoji.globs=private/**,docs/**,README.md

# 3. 编码防污染检查（严禁在 registry/文档/技能中写入 GBK/ANSI 转义乱码）
#    vertical/** vendored 上游文档编码归上游负责
mojibakeLevel=error
gate.mojibake.exclude=vertical/**

# 4. 敏感密钥拦截（三层规则：L1 签名层 19 模式 / L2 通用赋值+熵检 warn / L3 UTF-16+b64 编码配对 warn）
#    vertical/** 为 vendored 上游内容——其 fixture 假密钥非本仓安全面（供应链层管 provenance，不管内容）
secretLevel=error
gate.secrets.exclude=vertical/**
gate.secrets.genericLevel=warn
gate.secrets.b64Level=warn

# 5. 自动化测试门禁（提交前命令门——command 键指向 verify affected：
#    由 scripts/plan.mjs 做影响面计划，docs-only 提交免测放行）
lintLevel=error
gate.impact-test.command=node scripts/verify.mjs --profile affected

# 6. AI 署名 trailer 门禁（拦截 Generated with / Co-Authored-By 字段；署名即作者本人）
trailerLevel=error

# 7. 可自愈门仓专排除（门默认值仓中性——本仓 vendored/上游目录走配置排除）
gate.whitespace.exclude=vertical/**
gate.toc.exclude=vertical/**,base/**

# ── chores 族（suggest-only：只提醒不执行，post-merge 触发，永不阻断）──
chore.registry.watch=registry.yaml
chore.registry.message=registry.yaml 已变更——建议 pwsh scripts/sync.ps1 -DryRun 预览部署差异
chore.submodule.watch=base/reverse-skill
chore.submodule.message=submodule 指针已更新——执行 git submodule update --init 同步基座
chore.hooks.watch=scripts/hooks/**,.githooks/**
chore.hooks.message=门禁引擎/shim 已变更——确认无误后执行 node scripts/hooks/engine.mjs trust 再确认完整性
